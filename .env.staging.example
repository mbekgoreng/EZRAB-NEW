# ==============================================================================
# EZRAB AI CORE — STAGING ENVIRONMENT CONFIGURATION CONTRACT
# ==============================================================================
# CATATAN KEAMANAN: File ini adalah template dummy/contoh.
# JANGAN memasukkan secret production ke dalam file ini.
# Copy file ini ke `.env.staging` pada staging runner sebelum deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=staging
PORT=3000
VITE_APP_TITLE="EZRAB AI Construction Estimation (Staging)"
VITE_API_BASE_URL=http://127.0.0.1:3000/api
EZRAB_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY POLICY
# ------------------------------------------------------------------------------
# Mode autentikasi: 'trusted' (wajib untuk staging & production) atau 'legacy-development'
EZRAB_AUTH_MODE=trusted
JWT_SECRET=staging-jwt-secret-key-min-32-chars-xyz123456
SESSION_EXPIRY_SECONDS=86400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ------------------------------------------------------------------------------
# 3. SUPABASE STAGING DATABASE (ISOLATED STAGING INSTANCE ONLY)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://staging-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-anon-token-sample
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-service-role-sample

# ------------------------------------------------------------------------------
# 4. EZRAB LOCAL AI CORE BRIDGE
# ------------------------------------------------------------------------------
EZRAB_AI_CORE_URL=http://127.0.0.1:8000
EZRAB_AI_CORE_SERVICE_TOKEN=staging-internal-service-token-secret-9988
EZRAB_AI_CORE_TIMEOUT_MS=40000
EZRAB_AI_PROVIDER_PRIMARY=ollama
EZRAB_AI_MODEL_PRIMARY=qwen2.5:7b-instruct-q4_K_M

# ------------------------------------------------------------------------------
# 5. MODEL PROVIDERS & FALLBACK MATRIX (STAGING TEST KEYS)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional external provider fallback keys (jika diaktifkan pada staging)
GEMINI_API_KEY=AIzaSyStagingSampleKey0000000000000000000
OPENAI_API_KEY=sk-proj-staging-sample-key-000000000000000000
ANTHROPIC_API_KEY=sk-ant-staging-sample-key-000000000000000000
DEEPSEEK_API_KEY=sk-staging-deepseek-sample-key-000000000000

# ------------------------------------------------------------------------------
# 6. FEATURE FLAGS & LOGGING
# ------------------------------------------------------------------------------
ENABLE_AI_AUDIT_LOGGING=true
ENABLE_PROMPT_SANITIZATION=true
LOG_LEVEL=info
