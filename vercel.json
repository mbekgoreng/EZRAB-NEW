{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:full",
  "framework": "vite",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "destination": "/blog/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "blog.ezrab.site"
        }
      ],
      "source": "/robots.txt"
    },
    {
      "destination": "/blog/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "blog.ezrab.site"
        }
      ],
      "source": "/sitemap.xml"
    },
    {
      "destination": "/blog/sitemap.xml",
      "source": "/sitemap.xml"
    },
    {
      "destination": "/blog/$1",
      "has": [
        {
          "type": "host",
          "value": "blog.ezrab.site"
        }
      ],
      "source": "/((?!api/).*)"
    },
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    }
  ],
  "functions": {
    "api/ai/**/*.js": {
      "maxDuration": 300
    }
  }
}