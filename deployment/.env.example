# ==============================================================================
# EZRAB — contoh env untuk deployment Docker (AWS EC2 / VPS).
# Salin menjadi .env.docker DI SERVER (jangan commit, jangan isi di repo).
# Semua nilai dikosongkan: fitur yang env-nya kosong nonaktif secara jujur
# (fail-closed), sama seperti di Vercel. Nama-nama ini adalah HIMPUNAN yang
# benar-benar dibaca oleh api/ + runner; daftar AI lengkap ada di .env.example
# root. Nilai diisi OWNER langsung di server — tidak lewat chat/log.
# ==============================================================================

# --- Publik (ter-bake ke bundle frontend saat build; BUKAN secret) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Kosongkan = frontend memanggil /api pada origin yang sama (disarankan).
VITE_EZRAB_API_BASE_URL=

# --- Gerbang akses sementara (WAJIB agar /app dapat dibuka) ---
# EZRAB_ACCESS_CODE = kode yang diketik pengguna di halaman /access.
# EZRAB_ACCESS_SESSION_SECRET = kunci HMAC sesi, minimal 16 karakter
# (buat dengan: openssl rand -hex 32).
EZRAB_ACCESS_CODE=
EZRAB_ACCESS_SESSION_SECRET=

# --- CORS: origin tambahan yang diizinkan memanggil API (koma, persis) ---
# Sertakan domain produksi baru, mis. https://ezrab.site
CORS_ALLOWED_ORIGINS=

# --- Supabase server-side (verifikasi JWT pengguna) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Set "true" HANYA setelah backend kredit benar-benar terhubung & teruji;
# saat ini adapter kredit masih placeholder (endpoint menjawab 503 jujur).
CREDITS_DB_CONFIGURED=

# --- AI Gateway ---
# Token layanan server-only (openssl rand -hex 32). Bila kosong, gateway
# berjalan DEGRADED (rate limit ketat + cek origin).
AI_GATEWAY_TOKEN=
# JANGAN set true di produksi: gateway menolaknya saat APP_ENV=production
# (APP_ENV adalah penanda produksi portabel yang ditambahkan pada migrasi
# ini; di Vercel penanda aslinya VERCEL_ENV — keduanya diakui).
AI_ALLOW_ANONYMOUS=
AI_RATE_LIMIT_PER_MIN=
# Set "production" di server produksi AWS/VPS.
APP_ENV=

# --- Kunci provider AI (server-only; isi yang dipakai saja) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
ZYROUTER_API_KEY=
ZROUTER_API_KEY=
ATRIA_API_KEY_1=
CROWN_API_KEY=
ATMO_API_KEY=

# --- Pencarian harga pasar (Serper) ---
SERPER_API_KEY=

# --- Undangan via email (Resend; kosong = email nonaktif jujur) ---
RESEND_API_KEY=
EMAIL_FROM=
# URL publik aplikasi untuk tautan undangan (domain produksi).
PUBLIC_APP_URL=

# --- Lokal saja ---
WEB_PORT=8080
LOCAL_DB_PASSWORD=
