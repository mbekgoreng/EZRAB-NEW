# ==============================================================================
# EZRAB AI BACKEND CONFIGURATION (PHASE 9.3 — MULTI-PROVIDER AI & KEY POOLS)
# ==============================================================================

# AI Router Mode: 'auto' (default multi-provider cost router) | 'ezrab_core' | 'local' | 'external' | 'test'
AI_ROUTER_MODE=auto
AI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI (5 API KEY SLOTS SUPPORTED)
# ------------------------------------------------------------------------------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Gemini Model Identifiers (Configurable)
GEMINI_MODEL_FLASH_LITE=gemini-2.0-flash-lite
GEMINI_MODEL_FLASH=gemini-2.0-flash
GEMINI_MODEL_PRO=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 2. ATRIA ASI (15 API KEY SLOTS SUPPORTED)
# ------------------------------------------------------------------------------
ATRIA_API_KEY_1=
ATRIA_API_KEY_2=
ATRIA_API_KEY_3=
ATRIA_API_KEY_4=
ATRIA_API_KEY_5=
ATRIA_API_KEY_6=
ATRIA_API_KEY_7=
ATRIA_API_KEY_8=
ATRIA_API_KEY_9=
ATRIA_API_KEY_10=
ATRIA_API_KEY_11=
ATRIA_API_KEY_12=
ATRIA_API_KEY_13=
ATRIA_API_KEY_14=
ATRIA_API_KEY_15=

ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_OPENAI_BASE_URL=https://api.atria-asi.ai
ATRIA_MODEL=Atria-Dawn-Preview

# ------------------------------------------------------------------------------
# 3. INCEPTIONLABS / MERCURY (15 API KEY SLOTS SUPPORTED)
# ------------------------------------------------------------------------------
INCEPTION_API_KEY_1=
INCEPTION_API_KEY_2=
INCEPTION_API_KEY_3=
INCEPTION_API_KEY_4=
INCEPTION_API_KEY_5=
INCEPTION_API_KEY_6=
INCEPTION_API_KEY_7=
INCEPTION_API_KEY_8=
INCEPTION_API_KEY_9=
INCEPTION_API_KEY_10=
INCEPTION_API_KEY_11=
INCEPTION_API_KEY_12=
INCEPTION_API_KEY_13=
INCEPTION_API_KEY_14=
INCEPTION_API_KEY_15=

INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_OPENAI_BASE_URL=https://api.inceptionlabs.ai
INCEPTION_MODEL=mercury-2.5

# ------------------------------------------------------------------------------
# 4. ZROUTER OPENAI-COMPATIBLE GATEWAY (1 KEY SUPPORTED)
# ------------------------------------------------------------------------------
ZROUTER_BASE_URL=https://api.zrouter.dev/v1
ZROUTER_API_KEY=
ZROUTER_MODEL=gpt-5.4-mini

# ------------------------------------------------------------------------------
# 5. BUDGET GUARDRAILS & LIMITS (USD)
# ------------------------------------------------------------------------------
AI_MAX_COST_PER_REQUEST=0.50
AI_MAX_COST_PER_TASK=1.00
MAX_AI_COST_PER_DAY=10.00
MAX_AI_COST_PER_PROJECT=50.00

# ------------------------------------------------------------------------------
# 6. QUALITY TIER MODEL DEFAULTS
# ------------------------------------------------------------------------------
AI_DEFAULT_CHEAP_MODEL=gpt-5.4-mini
AI_DEFAULT_BALANCED_MODEL=mercury-2.5
AI_DEFAULT_PREMIUM_MODEL=gemini-1.5-pro
AI_DEFAULT_FRONTIER_MODEL=gpt-6-astra

# ------------------------------------------------------------------------------
# 7. SERVER & CORE SETTINGS
# ------------------------------------------------------------------------------
PORT=3001
EZRAB_AI_CORE_URL=http://127.0.0.1:8000
EZRAB_AI_CORE_TIMEOUT_MS=40000
EZRAB_AI_CORE_SERVICE_TOKEN=
EZRAB_AI_CORE_REQUIRE_SERVICE_TOKEN=false
EZRAB_OLLAMA_URL=http://127.0.0.1:11434
EZRAB_OLLAMA_TIMEOUT_SECONDS=35
DEFAULT_WORKSPACE_ID=ws-default-ezrab

# ------------------------------------------------------------------------------
# 8. SUPABASE (BACKEND SERVER SECRETS ONLY)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 9. AI GATEWAY HARDENING (Phase 2) — Vercel serverless (api/_lib/)
# ------------------------------------------------------------------------------
# Service token for AI endpoints. When set, requests to /api/ai/* MUST carry it
# as `x-ezrab-api-token` header (or Authorization: Bearer). Fail-closed.
# When empty, the gateway runs DEGRADED: strict rate limit + origin check only.
# Generate: openssl rand -hex 32   (then ALSO set VITE_AI_GATEWAY_TOKEN below
# so the SPA sends it; the browser copy is public by nature — it is abuse
# friction, not per-user auth.)
AI_GATEWAY_TOKEN=
# Requests per minute per IP per function instance (default 20 degraded / 60 with token)
AI_RATE_LIMIT_PER_MIN=
# Extra allowed CORS origins, comma-separated (production + *.vercel.app built in)
CORS_ALLOWED_ORIGINS=
# Browser copy of the gateway token (Vite public env). Optional; only needed
# when AI_GATEWAY_TOKEN is enforced server-side.
VITE_AI_GATEWAY_TOKEN=
